# Noodle guest kernel options.
#
# scripts/build-kernel.sh starts from `make ARCH=arm64 tinyconfig`, merges this
# file over it and runs olddefconfig. Everything is built in: the guest has no
# module loader, so a feature missing here is missing in every container.
# After olddefconfig the build checks that each "=y" below survived and fails
# when kconfig dropped one for an unmet dependency.
#
# Sections follow Noodle's own layers, from the image build down to the
# workloads that only the privileged VM runs. Symbols are sorted inside each
# section. Each symbol appears once.

# === Build profile =========================================================
# Built for speed over size: -O2 adds 1.7 MB to the image but saves 6 ms per
# wake and 0.3 ms per container start (Mac mini M4, 2026-11-07). No debug
# info, symbol table, profiler or module support.
CONFIG_64BIT=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_KALLSYMS is not set
# CONFIG_MODULES is not set
CONFIG_NR_CPUS=16
CONFIG_PRINTK=y
# CONFIG_PROFILING is not set
CONFIG_SMP=y

# === Virtual machine devices ===============================================
# Virtualization.framework presents virtio devices on a generic PCI host.
# Block: the ext4 data disk. Net: the VM's NAT uplink. Console: hvc0, where
# boot steps log. Entropy: the guest RNG. Vsock: the control and stream
# channels to noodled. virtiofs (over FUSE): bind mounts and Finder shares.
CONFIG_BLOCK=y
CONFIG_HVC_DRIVER=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_FS=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VSOCKETS=y
CONFIG_FUSE_FS=y
# The PL031 real-time clock sets the wall clock at boot. Without it the guest
# starts in 1970 and every TLS certificate check fails.
CONFIG_ARM_AMBA=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PL031=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"

# === Guest memory ==========================================================
# Idle memory is a product budget. The balloon and free page reporting hand
# unused guest pages back to macOS; compaction makes whole pages free.
# Transparent huge pages would pin memory the host could reclaim.
CONFIG_BALLOON_COMPACTION=y
CONFIG_COMPACTION=y
CONFIG_MEMORY_BALLOON=y
CONFIG_PAGE_REPORTING=y
CONFIG_VIRTIO_BALLOON=y
# CONFIG_TRANSPARENT_HUGEPAGE is not set
# Swap accounting code only, for memory.swap.max (docker --memory-swap).
# No swap device is ever attached.
CONFIG_SWAP=y

# === Agent boot ============================================================
# The Zig agent is PID 1 inside a gzip or zstd initramfs (rdinit=/init). It
# re-roots onto tmpfs, mounts /proc, /sys and /dev, then serves vsock.
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_SHMEM=y
CONFIG_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y

# === Linux userland ABI ====================================================
# What ordinary container images expect from any Linux kernel: threads,
# event loops, timers, IPC, users, file locks and change notification.
# tinyconfig leaves several of these out.
CONFIG_ADVISE_SYSCALLS=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_FILE_LOCKING=y
CONFIG_FSNOTIFY=y
CONFIG_FUTEX=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_INOTIFY_USER=y
CONFIG_IO_URING=y
CONFIG_MULTIUSER=y
CONFIG_NO_HZ_IDLE=y
CONFIG_PACKET=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SIGNALFD=y
CONFIG_SYSVIPC=y
CONFIG_TIMERFD=y
CONFIG_UNIX=y
# alarm() and setitimer(): without them busybox `ping -W` hangs on a lost reply.
CONFIG_POSIX_TIMERS=y
# name_to_handle_at, used by systemd inside containers.
CONFIG_FHANDLE=y
# Keyrings: kubelet reads /proc/sys/kernel/keys/root_maxkeys.
CONFIG_KEYS=y
# Foreign-architecture binaries through the Rosetta share.
CONFIG_BINFMT_MISC=y

# === Container storage =====================================================
# Images unpack onto the ext4 data disk; overlayfs stacks a container's
# writable layer over them. Privileged containers may use loop devices
# (losetup), which the custom-kernel e2e run found missing.
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_OVERLAY_FS=y

# === Container isolation ===================================================
# One set of namespaces per container, cgroup v2 limits for every docker run
# resource flag, the agent's device policy (cgroup BPF) and its seccomp
# filter. PSI provides the cgroup v2 *.pressure files that tools in
# containers read.
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_IPC_NS=y
CONFIG_MEMCG=y
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_PSI=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
# Kubelet's per-pod accounting: perf events and HugeTLB controllers.
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_PERF=y
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y
CONFIG_PERF_EVENTS=y

# === Docker networks =======================================================
# A bridge per network and a veth pair per container, IPv4 and dual stack.
# Policy routing serves containers on several networks and keeps the VM's
# IPv6 default route from router advertisements once forwarding is on.
# /dev/net/tun is for VPN clients in privileged containers.
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_ROUTE_INFO=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_TUN=y
CONFIG_VETH=y
# Socket listings for ss and similar tools inside containers.
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_INET_UDP_DIAG=y
CONFIG_PACKET_DIAG=y
CONFIG_UNIX_DIAG=y

# === Agent firewall (nftables) =============================================
# The agent writes its own nftables tables over nfnetlink: masquerade for
# outbound traffic, DNAT for published ports, and isolation for --internal
# networks. Connection tracking sits under all of it.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
# counter, meta, payload, cmp, lookup, bitwise and exthdr come with NF_TABLES.

# === Firewalls run by workloads ============================================
# Privileged containers and the Kubernetes workload VM bring their own rules:
# Docker-in-Docker, kube-proxy (iptables, nftables or IPVS mode), flannel,
# servicelb and network-policy controllers. Both iptables front ends work:
# iptables-nft through NFT_COMPAT, and legacy tables, which in 6.18 need the
# shared and the per-family legacy switches. XT_NAT supplies DNAT and SNAT;
# the family REJECT targets supply REJECT.
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NFT_COMPAT=y
# Conntrack state that controllers read and clean up over netlink, plus the
# userspace queue and log targets.
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_LABELS=y
CONFIG_NF_CT_NETLINK=y
# nftables expressions that kube-proxy's nftables mode and common host
# firewalls use, for every family including bridge and netdev.
CONFIG_NF_LOG_SYSLOG=y
CONFIG_NF_SOCKET_IPV4=y
CONFIG_NF_SOCKET_IPV6=y
CONFIG_NF_TABLES_BRIDGE=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TPROXY_IPV4=y
CONFIG_NF_TPROXY_IPV6=y
CONFIG_NFT_BRIDGE_META=y
CONFIG_NFT_BRIDGE_REJECT=y
CONFIG_NFT_CONNLIMIT=y
CONFIG_NFT_DUP_IPV4=y
CONFIG_NFT_DUP_IPV6=y
CONFIG_NFT_DUP_NETDEV=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_NETDEV=y
CONFIG_NFT_FWD_NETDEV=y
CONFIG_NFT_HASH=y
CONFIG_NFT_LOG=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_QUEUE=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_REJECT_IPV4=y
CONFIG_NFT_REJECT_IPV6=y
CONFIG_NFT_REJECT_NETDEV=y
CONFIG_NFT_SOCKET=y
CONFIG_NFT_TPROXY=y

# === Kubernetes service paths ==============================================
# Network-policy sets: hash families and lists of sets, no bitmap types.
# XT_SET gives iptables both the set match and the SET target.
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_IPMAC=y
CONFIG_IP_SET_HASH_IPMARK=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_HASH_IPPORTIP=y
CONFIG_IP_SET_HASH_IPPORTNET=y
CONFIG_IP_SET_HASH_MAC=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_NETIFACE=y
CONFIG_IP_SET_HASH_NETNET=y
CONFIG_IP_SET_HASH_NETPORT=y
CONFIG_IP_SET_HASH_NETPORTNET=y
CONFIG_IP_SET_LIST_SET=y
CONFIG_NETFILTER_XT_SET=y
# kube-proxy IPVS mode: TCP and UDP, both families, four schedulers. NAT
# forwarding is part of the IPVS core.
CONFIG_IP_VS=y
CONFIG_IP_VS_IPV6=y
CONFIG_IP_VS_LC=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=y
CONFIG_IP_VS_SH=y
CONFIG_IP_VS_WRR=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
# flannel's opt-in VXLAN backend. The default host-gw backend needs routes only.
CONFIG_VXLAN=y

# === Traffic control =======================================================
# tc inside privileged containers and CNI plugins: a few qdiscs, classifiers
# and actions, not every scheduler. The cgroup classifier is the legacy
# net_cls interface; it does not add a cgroup v2 controller.
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_ACT_GACT=y
CONFIG_NET_ACT_MIRRED=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_NET_CLS_FLOWER=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_SCH_NETEM=y

# === Kept out on purpose ===================================================
# Vsock loopback would let a container connect to the agent's own listeners
# (asserted by priv-negative-probes).
# CONFIG_VSOCKETS_LOOPBACK is not set
# The sit0 tunnel device would show up in --network none containers, which
# must see only lo (asserted by net-mode-none).
# CONFIG_IPV6_SIT is not set

# Kept off on purpose: no core_pattern pipe and no uevent helper for a privileged container to point at a payload.
# CONFIG_COREDUMP is not set
# CONFIG_UEVENT_HELPER is not set
